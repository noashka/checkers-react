{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "types": ["vitest/globals", "vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "config", "vite.config.ts"]
}
